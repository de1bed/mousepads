# ─── MexPads · variables del backend ───────────────────────────────────────
# En Vercel: Project → Settings → Environment Variables.
# En local: copia esto a .env y córrelo con `node --env-file=.env ...`

# ── Shopify (obligatorio) ──
# Opción A (la más simple): app personalizada en Shopify admin →
#   Configuración → Apps y canales de venta → Desarrollar apps → Crear app.
#   Permisos de Admin API: write_files, read_files, read_orders, write_orders,
#   write_themes (sólo si vas a subir el tema puente).
#   Copia el "Admin API access token" (empieza con shpat_).
SHOPIFY_ADMIN_TOKEN=

# Opción B: credenciales de app con client_credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Ojo: el dominio principal de la tienda es mexpads.myshopify.com (alias);
# el interno es h2vwbt-nr.myshopify.com. Los dos funcionan aquí.
SHOPIFY_SHOP_DOMAIN=mexpads.myshopify.com
SHOPIFY_API_VERSION=2025-01

# ── Webhook de pedidos (obligatorio para que llegue el correo) ──
# Shopify admin → Configuración → Notificaciones → Webhooks →
#   evento "Creación de pedido", formato JSON, URL:
#   https://mexpads.com/api/webhooks/orders-create
# Shopify muestra la clave secreta al final de esa página; va aquí.
SHOPIFY_WEBHOOK_SECRET=

# ── Correo (OPCIONAL) ──
# Sin esto NO se rompe nada: los enlaces al archivo de impresión se escriben
# igual en la nota del pedido, que se ve al abrirlo en el admin de Shopify.
# Si lo quieres además por correo, cuenta gratis en resend.com → API Keys.
RESEND_API_KEY=
# A dónde llegan los diseños. Separa varios con comas.
PRINT_EMAIL_TO=davidrocha0520@gmail.com
# Remitente. Con dominio verificado en Resend: MexPads <pedidos@mexpads.com>
PRINT_EMAIL_FROM=MexPads <onboarding@resend.dev>

# ── Rehacer paquetes a mano (OPCIONAL, POST /api/print/build) ──
# Inventa una cadena larga; es la que va en la cabecera x-mexpads-key.
ADMIN_API_KEY=

# ── Impresión ──
PUBLIC_BASE_URL=https://mexpads.com
PRINT_DPI=300
PRINT_BLEED_MM=3

# Orígenes extra permitidos por CORS, separados por comas (opcional).
ALLOWED_ORIGINS=
